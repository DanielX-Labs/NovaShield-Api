# ============================================
# NOVASHIELD
# ============================================

NODE_ENV=development
PORT=4001
APP_NAME=NovaShield


# ============================================
# DATABASE
# ============================================

MONGODB_URI=mongodb://127.0.0.1:27017/novashield


# ============================================
# EXPENSEHUB
# Next.js frontend
# ============================================

EXPENSEHUB_ORIGIN=http://localhost:3000


# ============================================
# AUTHENTICATION
# ============================================

JWT_ACCESS_SECRET=replace-me

REFRESH_TOKEN_TTL_DAYS=7

AUTH_PEPPER=replace-me


# ============================================
# EMAIL PROVIDER
# ============================================

EMAIL_PROVIDER=brevo


# ============================================
# BREVO - DEVELOPMENT ONLY
# ============================================

BREVO_SENDER_EMAIL=replace-with-verified-sender@example.com
BREVO_SENDER_NAME=NovaPay Security
SUPPORT_EMAIL=Support@gmail.com

BREVO_EMAIL_TRANSPORT=smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=replace-me
BREVO_SMTP_KEY=replace-me


# ============================================
# EMAIL OTP
# ============================================

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================
# PASSWORD SECURITY
# ============================================

PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_HISTORY_LIMIT=5

# Breach screening availability policy
BREACHED_PASSWORD_CHECK_ENABLED=true
BREACHED_PASSWORD_FAIL_MODE=closed
BREACHED_PASSWORD_TIMEOUT_MS=3000

# ============================================
# SESSION & TOKEN SECURITY
# ============================================

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_COOKIE_NAME=novashield_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOGIN_WINDOW_MINUTES=15
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=10
IP_HASH_SECRET=replace-me

# Password reset
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15
PASSWORD_RESET_REQUEST_LIMIT=5

# ============================================
# AUTHENTICATION ABUSE DEFENSE
# ============================================
AUTH_FAILURE_WINDOW_MINUTES=15
AUTH_ACCOUNT_FAILURE_LIMIT=8
AUTH_IP_FAILURE_LIMIT=30
AUTH_PROGRESSIVE_DELAY_AFTER=3
AUTH_PROGRESSIVE_DELAY_BASE_MS=500
AUTH_PROGRESSIVE_DELAY_MAX_MS=5000
AUTH_SPRAY_ACCOUNT_THRESHOLD=8
AUTH_SUSPICIOUS_SCORE_THRESHOLD=50
