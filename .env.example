# ============================================
# NOVASHIELD
# ============================================

NODE_ENV=development
PORT=4001
APP_NAME=NovaShield


# ============================================
# DATABASE
# ============================================

MONGODB_URI=mongodb://127.0.0.1:27017/novashield


# ============================================
# EXPENSEHUB
# Next.js frontend
# ============================================

EXPENSEHUB_ORIGIN=http://localhost:3000


# ============================================
# AUTHENTICATION
# ============================================

JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

AUTH_PEPPER=replace-me


# ============================================
# EMAIL
# ============================================

BREVO_EMAIL_TRANSPORT=smtp
SUPPORT_EMAIL=Support@gmail.com

BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=NovaPay Security


# ============================================
# BREVO SMTP
# ============================================

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=replace-me
BREVO_SMTP_KEY=replace-me


# ============================================
# EMAIL OTP
# ============================================

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60